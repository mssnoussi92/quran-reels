<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="utf-8">
<!--
  A whole surah as one long video (16:9, 1920×1080, longvideo.py): the same layers and variables
  as reel.html.j2, laid out for a landscape screen. The ayah and its translation on the right,
  every word meaning of the Muyassar for it on the left (`long.glosses` of project.yaml: all of
  them, not the reels' one or two); one column when the ayah has none.

  layer:
    static   scrim + handle + credits, constant for the whole video
    content  one per ayah (or per screen of a long ayah), faded in and out
    preview  static and content, on a gradient standing in for the video (mockups only)
    thumb    the video's thumbnail text (thumb: {title, subtitle, en, reciter})

  Text that does not fit is scaled down (--k); window.__fit holds the final factor.
-->
<style>
  @font-face { font-family: "AmiriQuran"; src: url("{{ fonts_dir }}/AmiriQuran-Regular.ttf"); }
  @font-face { font-family: "Amiri"; src: url("{{ fonts_dir }}/Amiri-Regular.ttf"); font-weight: 400; }
  @font-face { font-family: "Amiri"; src: url("{{ fonts_dir }}/Amiri-Bold.ttf"); font-weight: 700; }
  @font-face { font-family: "Lora"; src: url("{{ fonts_dir }}/Lora.ttf"); }

  :root { --k: 1; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 1920px; height: 1080px; background: transparent; }
  body { position: relative; overflow: hidden; color: #fff; }

  {% if layer == "preview" %}
  body { background: linear-gradient(180deg, #0b1026 0%, #1a2350 45%, #3b3a6b 72%, #8a5a5a 100%); }
  {% endif %}
  .scrim { position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,.40), rgba(0,0,0,.22) 30%, rgba(0,0,0,.22) 70%, rgba(0,0,0,.50)); }

  .content { position: absolute; top: {{ safe.top }}px; bottom: {{ safe.bottom + 20 }}px;
      left: {{ safe.sides }}px; right: {{ safe.sides }}px;
      display: flex; direction: rtl; gap: 56px; align-items: center; }
  .main { flex: 1 1 auto; display: flex; flex-direction: column; align-items: center;
      text-align: center; gap: calc(30px * var(--k)); }
  .side { flex: 0 0 640px; }

  .ref { font-family: "Amiri"; font-weight: 700; font-size: calc(34px * var(--k)); opacity: .85; }
  .ref span { font-family: "Lora"; font-size: calc(26px * var(--k)); opacity: .8;
      margin-inline-start: 12px; }
  .ayah { font-family: "AmiriQuran"; font-size: calc(68px * var(--k)); line-height: 1.95;
      text-wrap: balance; text-shadow: 0 4px 30px rgba(0,0,0,.6); }
  .ayah .hl { color: {{ highlight }}; }
  .ayah .num { font-size: calc(46px * var(--k)); opacity: .9; }
  .tr { direction: ltr; font-family: "Lora"; font-style: italic; font-size: calc(32px * var(--k));
      line-height: 1.45; max-width: 1100px; text-wrap: balance; text-shadow: 0 2px 16px rgba(0,0,0,.65); }

  .gloss { background: rgba(10,14,35,.62); border: 1px solid rgba(246,200,107,.35);
      border-radius: 24px; padding: calc(26px * var(--k)) 34px calc(22px * var(--k)); text-align: right; }
  .gloss h3 { font-family: "Amiri"; font-weight: 700; font-size: calc(30px * var(--k));
      color: {{ highlight }}; margin-bottom: calc(10px * var(--k)); }
  .gloss p { font-family: "Amiri"; font-size: calc(32px * var(--k)); line-height: 1.55; }
  .gloss p + p { margin-top: calc(10px * var(--k)); padding-top: calc(10px * var(--k));
      border-top: 1px solid rgba(255,255,255,.08); }
  .gloss p b { font-family: "AmiriQuran"; font-weight: 400; color: {{ highlight }}; }
  .gloss .src { font-family: "Amiri"; font-size: calc(22px * var(--k)); opacity: .7;
      margin-top: calc(10px * var(--k)); }

  .footer { position: absolute; bottom: {{ safe.bottom - 70 }}px; left: 0; right: 0;
      text-align: center; font-family: "Lora"; }
  .handle { font-size: 30px; font-weight: 600; letter-spacing: .03em; color: {{ highlight }};
      text-shadow: 0 1px 3px rgba(0,0,0,.8), 0 2px 14px rgba(0,0,0,.7); }
  .credit { font-size: 22px; color: rgba(255,255,255,.8); margin-top: 4px;
      text-shadow: 0 1px 3px rgba(0,0,0,.85), 0 0 12px rgba(0,0,0,.6); }

  /* The thumbnail: the surah's name large, what the video holds under it. */
  .thumb { position: absolute; inset: 0; display: flex; flex-direction: column;
      justify-content: center; align-items: center; text-align: center; gap: 18px;
      background: radial-gradient(ellipse at center, rgba(0,0,0,.35), rgba(0,0,0,.55)); }
  .thumb .t { font-family: "Amiri"; font-weight: 700; font-size: 230px; line-height: 1.25;
      direction: rtl; color: #fff; text-shadow: 0 8px 50px rgba(0,0,0,.75); }
  .thumb .s { font-family: "Amiri"; font-weight: 700; font-size: 92px; direction: rtl;
      color: {{ highlight }}; text-shadow: 0 4px 30px rgba(0,0,0,.75); }
  .thumb .e { font-family: "Lora"; font-size: 54px; font-weight: 600;
      text-shadow: 0 3px 20px rgba(0,0,0,.8); }
  .thumb .r { font-family: "Amiri"; font-size: 52px; direction: rtl; opacity: .92;
      text-shadow: 0 3px 20px rgba(0,0,0,.8); }
</style>
</head>
<body>
  {% if layer in ("static", "preview") %}
  <div class="scrim"></div>
  {% endif %}
  {% if layer == "thumb" %}
  <div class="thumb">
    <div class="t">{{ thumb.title }}</div>
    <div class="s">{{ thumb.subtitle }}</div>
    <div class="e">{{ thumb.en }}</div>
    <div class="r">{{ thumb.reciter }}</div>
  </div>
  {% endif %}
  {% if layer in ("content", "preview") %}
  <div class="content">
    <div class="main col">
      <div class="ref">{{ surah_name_ar }}{% if ref %} <span>· {{ ref }}</span>{% endif %}</div>
      <div class="ayah">
        {%- for t in tokens -%}
          {% if t.hl %}<span class="hl">{{ t.text }}</span>{% else %}{{ t.text }}{% endif %}{{ " " if not loop.last else (" " if ayah_number else "") }}
        {%- endfor -%}
        {% if ayah_number %}<span class="num">﴿{{ ayah_number }}﴾</span>{% endif %}
      </div>
      <div class="tr">{{ translation }}</div>
    </div>
    {% if glosses %}
    <div class="side col">
      <div class="gloss">
        <h3>معاني الكلمات</h3>
        {% for g in glosses %}<p><b>{{ g.word }}</b> : {{ g.gloss }}</p>{% endfor %}
        <div class="src">— {{ gloss_source }}</div>
      </div>
    </div>
    {% endif %}
  </div>
  {% endif %}
  {% if layer in ("static", "preview") %}
  <div class="footer">
    <div class="handle">{{ handle }}</div>
    <div class="credit">{{ credit }}</div>
  </div>
  {% endif %}
<script>
  document.fonts.ready.then(() => {
    const box = document.querySelector(".content");
    const cols = [...document.querySelectorAll(".col")];
    let k = 1;
    if (box && cols.length) {
      const over = () => cols.some(c => c.scrollHeight > box.clientHeight);
      for (let i = 0; i < 60 && over(); i++) {
        k *= 0.97;
        document.documentElement.style.setProperty("--k", k);
      }
    }
    window.__fit = k;
  });
</script>
</body>
</html>
