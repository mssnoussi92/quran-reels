<!DOCTYPE html>
<html lang="ar">
<head>
<meta charset="utf-8">
<!--
  Rendered to transparent PNGs and overlaid on the background video by ffmpeg.

  layer:
    static   scrim + handle + credits, constant for the whole video
    content  one per ayah (reference, ayah, translation, glosses), faded in and out
    hook     the screen of the question on a word (video.hook), before the first ayah: the word
             large, the question under it, in Arabic then in English
    preview  static and content, on a gradient standing in for the video (mockups only)
    hookpreview  static and hook, on that gradient

  Variables:
    fonts_dir        file:// URI of assets/fonts
    series           "آيات الدعاء · ٣ من ٣٨" on the first frame of a series, else empty
    surah_name_ar    "سورة الضحى"
    ref              "93:2"
    tokens           [{text, hl}]   Uthmani words, hl=true for glossed words
    ayah_number      "٢" (empty on the basmala frame, like ref)
    translation      verbatim translation
    glosses          [{word, gloss}]  verbatim from the gloss edition
    gloss_source     "ابن قتيبة، تفسير غريب القرآن"
    credit           "Mishary Rashid Alafasy · Sahih International"
    handle           "@quran_words_daily"  page signature, on every frame
    safe             {top, bottom, sides}
    highlight        "#f6c86b"
    hook             {word, question, en} on the layers hook and hookpreview (video.hook)

  Text that does not fit between the safe margins is scaled down (--k) by the script below;
  window.__fit holds the final factor.
-->
<style>
  @font-face { font-family: "AmiriQuran"; src: url("{{ fonts_dir }}/AmiriQuran-Regular.ttf"); }
  @font-face { font-family: "Amiri"; src: url("{{ fonts_dir }}/Amiri-Regular.ttf"); font-weight: 400; }
  @font-face { font-family: "Amiri"; src: url("{{ fonts_dir }}/Amiri-Bold.ttf"); font-weight: 700; }
  @font-face { font-family: "Lora"; src: url("{{ fonts_dir }}/Lora.ttf"); }
  /* ﷺ, which Lora lacks (a box in its place: 18:1 of the long Al-Kahf, 2026-11-27): Amiri's, for
     that one sign only; every other letter Lora lacks falls back as before. */
  @font-face { font-family: "Salawat"; src: url("{{ fonts_dir }}/Amiri-Regular.ttf"); unicode-range: U+FDFA; }

  :root { --k: 1; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 1080px; height: 1920px; background: transparent; }
  body { position: relative; overflow: hidden; color: #fff; }

  {% if layer in ("preview", "hookpreview") %}
  body { background: linear-gradient(180deg, #0b1026 0%, #1a2350 45%, #3b3a6b 72%, #8a5a5a 100%); }
  {% endif %}
  .scrim { position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(0,0,0,.35), rgba(0,0,0,.15) 30%, rgba(0,0,0,.15) 70%, rgba(0,0,0,.45)); }

  /* Between the safe margins, above the footer. */
  .content { position: absolute; top: {{ safe.top }}px; bottom: {{ safe.bottom + 150 }}px;
      left: {{ safe.sides }}px; right: {{ safe.sides }}px;
      display: flex; flex-direction: column; justify-content: center; align-items: center; }
  .stack { width: 100%; display: flex; flex-direction: column; align-items: center;
      text-align: center; gap: calc(56px * var(--k)); }

  .series { font-family: "Amiri"; font-weight: 700; font-size: calc(38px * var(--k));
      color: {{ highlight }}; direction: rtl; padding: calc(6px * var(--k)) 28px;
      border: 1px solid rgba(246,200,107,.45); border-radius: 999px;
      background: rgba(10,14,35,.45); margin-bottom: calc(-24px * var(--k)); }
  .ref { font-family: "Amiri"; font-weight: 700; font-size: calc(40px * var(--k)); opacity: .85;
      direction: rtl; }
  .ref span { font-family: "Lora", "Salawat"; font-size: calc(30px * var(--k)); opacity: .8;
      margin-inline-start: 14px; }

  .ayah { font-family: "AmiriQuran"; font-size: calc(112px * var(--k)); line-height: 1.9;
      direction: rtl; text-wrap: balance; text-shadow: 0 4px 30px rgba(0,0,0,.55); }
  .ayah .hl { color: {{ highlight }}; }
  .ayah .num { font-size: calc(72px * var(--k)); opacity: .9; }

  /* The screen of the question on a word (video.hook), before the first ayah: the word large
     and alone, the question under it; drawn centred, video.compose makes it grow as it comes. */
  .intro { position: absolute; top: {{ safe.top }}px; bottom: {{ safe.bottom + 150 }}px;
      left: {{ safe.sides }}px; right: {{ safe.sides }}px; display: flex; flex-direction: column;
      justify-content: center; align-items: center; text-align: center; }
  .intro .ibox { width: 100%; display: flex; flex-direction: column; align-items: center;
      gap: calc(30px * var(--k)); }
  .intro .w { font-family: "AmiriQuran"; color: {{ highlight }}; direction: rtl;
      font-size: calc(170px * var(--k)); line-height: 1.7; text-wrap: balance;
      text-shadow: 0 6px 40px rgba(0,0,0,.6); }
  .intro .w .g { font-family: "Amiri"; font-size: .55em; vertical-align: .35em; opacity: .9; }
  .intro .q { font-family: "Amiri"; font-weight: 700; font-size: calc(84px * var(--k));
      direction: rtl; text-shadow: 0 3px 24px rgba(0,0,0,.6); }
  .intro .en { font-family: "Lora", "Salawat"; font-style: italic; font-size: calc(44px * var(--k));
      opacity: .92; text-shadow: 0 2px 16px rgba(0,0,0,.6); }

  .tr { font-family: "Lora", "Salawat"; font-style: italic; font-size: calc(46px * var(--k)); line-height: 1.45;
      max-width: 860px; text-wrap: balance; text-shadow: 0 2px 16px rgba(0,0,0,.6); }

  .gloss { direction: rtl; width: 100%; background: rgba(10,14,35,.6);
      border: 1px solid rgba(246,200,107,.35); border-radius: 28px;
      padding: calc(34px * var(--k)) 44px calc(28px * var(--k)); text-align: right; }
  .gloss h3 { font-family: "Amiri"; font-weight: 700; font-size: calc(34px * var(--k));
      color: {{ highlight }}; margin-bottom: calc(14px * var(--k)); }
  .gloss p { font-family: "Amiri"; font-size: calc(44px * var(--k)); line-height: 1.6; }
  .gloss p + p { margin-top: calc(10px * var(--k)); }
  .gloss p b { font-family: "AmiriQuran"; font-weight: 400; color: {{ highlight }}; }
  .gloss .src { font-family: "Amiri"; font-size: calc(26px * var(--k)); opacity: .7;
      margin-top: calc(10px * var(--k)); }

  .footer { position: absolute; bottom: {{ safe.bottom + 20 }}px; left: 0; right: 0;
      text-align: center; font-family: "Lora", "Salawat"; }
  /* A tight shadow plus a soft one: readable over a bright horizon or white water. */
  .handle { font-size: 36px; font-weight: 600; letter-spacing: .03em; color: {{ highlight }};
      text-shadow: 0 1px 3px rgba(0,0,0,.8), 0 2px 14px rgba(0,0,0,.7); }
  .credit { font-size: 26px; color: rgba(255,255,255,.8); margin-top: 6px;
      text-shadow: 0 1px 3px rgba(0,0,0,.85), 0 0 12px rgba(0,0,0,.6); }
</style>
</head>
<body>
  {% if layer in ("static", "preview", "hookpreview") %}
  <div class="scrim"></div>
  {% endif %}
  {% if layer in ("hook", "hookpreview") %}
  <div class="intro"><div class="ibox">
    <div class="w"><span class="g">«</span>{{ hook.word }}<span class="g">»</span></div>
    <div class="q">{{ hook.question }}</div>
    {% if hook.en %}<div class="en">{{ hook.en }}</div>{% endif %}
  </div></div>
  {% endif %}
  {% if layer in ("content", "preview") %}
  <div class="content">
    <div class="stack">
      {% if series %}<div class="series">{{ series }}</div>{% endif %}
      <div class="ref">{{ surah_name_ar }}{% if ref %} <span>· {{ ref }}</span>{% endif %}</div>
      <div class="ayah">
        {%- for t in tokens -%}
          {% if t.hl %}<span class="hl">{{ t.text }}</span>{% else %}{{ t.text }}{% endif %}{{ " " if not loop.last else (" " if ayah_number else "") }}
        {%- endfor -%}
        {% if ayah_number %}<span class="num">﴿{{ ayah_number }}﴾</span>{% endif %}
      </div>
      <div class="tr">{{ translation }}</div>
      {% if glosses %}
      <div class="gloss">
        <h3>معاني الكلمات</h3>
        {% for g in glosses %}<p><b>{{ g.word }}</b> : {{ g.gloss }}</p>{% endfor %}
        <div class="src">— {{ gloss_source }}</div>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}
  {% if layer in ("static", "preview", "hookpreview") %}
  <div class="footer">
    <div class="handle">{{ handle }}</div>
    <div class="credit">{{ credit }}</div>
  </div>
  {% endif %}
<script>
  document.fonts.ready.then(() => {
    const box = document.querySelector(".content") || document.querySelector(".intro");
    const stack = document.querySelector(".stack") || document.querySelector(".ibox");
    let k = 1;
    if (box && stack) {
      for (let i = 0; i < 60 && stack.offsetHeight > box.clientHeight; i++) {
        k *= 0.97;
        document.documentElement.style.setProperty("--k", k);
      }
    }
    window.__fit = k;
  });
</script>
</body>
</html>
