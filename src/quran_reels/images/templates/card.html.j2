<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<!--
  Image posts, 1080x1350 (4:5), from the validated mockup docs/mockup/images/cards.html.
  card: word-1 (the word, also the grid thumbnail) | word-2 (its ayah and translation) |
        word-3 (its meaning, Ibn Qutaybah verbatim) | ayah (Ayah of the day).
  Every text comes from the sources (cache), never typed. Text that does not fit is scaled
  down (--k) by the script at the end; window.__fit holds the final factor.
-->
<style>
  @font-face { font-family: "AmiriQuran"; src: url("{{ fonts_dir }}/AmiriQuran-Regular.ttf"); }
  @font-face { font-family: "Amiri"; src: url("{{ fonts_dir }}/Amiri-Regular.ttf"); font-weight: 400; }
  @font-face { font-family: "Amiri"; src: url("{{ fonts_dir }}/Amiri-Bold.ttf"); font-weight: 700; }
  @font-face { font-family: "Lora"; src: url("{{ fonts_dir }}/Lora.ttf"); }

  :root { --k: 1; }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { width: 1080px; height: 1350px; overflow: hidden; }
  body { position: relative; color: #eef0fa;
    background:
      radial-gradient(ellipse 90% 45% at 50% 108%, rgba(255,170,90,.42), transparent 60%),
      radial-gradient(ellipse 60% 40% at 78% 12%, rgba(120,140,220,.20), transparent 70%),
      linear-gradient(180deg, #0b1026 0%, #1a2350 48%, #33335f 78%, #5e4458 100%); }
  .stars { position: absolute; inset: 0; background-image:
      radial-gradient(1.6px 1.6px at 12% 14%, #fff8, transparent), radial-gradient(1.2px 1.2px at 34% 7%, #fff9, transparent),
      radial-gradient(1.6px 1.6px at 61% 11%, #fff7, transparent), radial-gradient(1.2px 1.2px at 86% 6%, #fffa, transparent),
      radial-gradient(1.2px 1.2px at 92% 24%, #fff6, transparent), radial-gradient(1.6px 1.6px at 7% 31%, #fff5, transparent); }
  .frame { position: absolute; inset: 70px 80px 80px; display: flex; flex-direction: column; }
  .top { display: flex; justify-content: space-between; align-items: baseline; font-family: "Lora";
    font-size: 26px; letter-spacing: .14em; color: {{ highlight }}; text-transform: uppercase; }
  .top .ref { letter-spacing: .04em; color: #aab0cf; text-transform: none; }
  .center { flex: 1; min-height: 0; display: flex; flex-direction: column; justify-content: center;
    align-items: center; text-align: center; gap: calc(40px * var(--k)); }
  .bottom { display: flex; justify-content: space-between; align-items: flex-end; font-family: "Lora";
    font-size: 24px; color: #aab0cf; gap: 24px; }
  .bottom .handle { color: {{ highlight }}; font-size: 28px; letter-spacing: .03em; white-space: nowrap; }
  .swipe { font-family: "Lora"; font-style: italic; font-size: calc(30px * var(--k)); color: #aab0cf; }

  .big-word { font-family: "AmiriQuran"; font-size: calc(260px * var(--k)); line-height: 1.5;
    color: {{ highlight }}; direction: rtl; white-space: nowrap; text-shadow: 0 8px 40px rgba(0,0,0,.45); }
  .surah { font-family: "Amiri"; font-weight: 700; font-size: calc(44px * var(--k)); direction: rtl; }
  .surah span { font-family: "Lora"; font-weight: 400; font-size: calc(32px * var(--k)); color: #aab0cf;
    margin-inline-start: 12px; }

  .ayah { font-family: "AmiriQuran"; font-size: calc(100px * var(--k)); line-height: 1.95; direction: rtl;
    text-shadow: 0 4px 26px rgba(0,0,0,.5); }
  .ayah .hl { color: {{ highlight }}; }
  .ayah .num { font-size: calc(66px * var(--k)); }
  .tr { font-family: "Lora"; font-style: italic; font-size: calc(44px * var(--k)); line-height: 1.5;
    max-width: 880px; }
  .credit { font-family: "Lora"; font-size: 24px; color: #aab0cf; text-align: right; }

  .meaning-word { font-family: "AmiriQuran"; font-size: calc(150px * var(--k)); line-height: 1.5;
    color: {{ highlight }}; direction: rtl; white-space: nowrap; }
  .card { width: 100%; direction: rtl; text-align: right; background: rgba(10,14,35,.55);
    border: 1px solid rgba(246,200,107,.35); border-radius: 30px;
    padding: calc(44px * var(--k)) 52px calc(36px * var(--k)); }
  .card h3 { font-family: "Amiri"; font-weight: 700; font-size: calc(38px * var(--k));
    color: {{ highlight }}; margin-bottom: calc(18px * var(--k)); }
  .card p { font-family: "Amiri"; font-size: calc(60px * var(--k)); line-height: 1.6; }
  .card .src { font-family: "Amiri"; font-size: calc(30px * var(--k)); color: #aab0cf;
    margin-top: calc(18px * var(--k)); }
</style>
</head>
<body>
<div class="stars"></div>

{% macro ayah_lines(highlight_word) -%}
  <div class="ayah">{% for a in ayahs %}{% for t in a.tokens %}{% if t.hl and highlight_word %}<span class="hl">{{ t.text }}</span>{% else %}{{ t.text }}{% endif %} {% endfor %}<span class="num">﴿{{ a.number }}﴾</span>{% if not loop.last %} {% endif %}{% endfor %}</div>
{%- endmacro %}

{% if card == "word-1" %}
<div class="frame">
  <div class="top"><span>Word of the day</span><span class="ref">1 / 3</span></div>
  <div class="center">
    <div class="big-word">{{ word }}</div>
    <div class="surah">{{ surah_name_ar }} <span>· Surah {{ surah_name_en }} {{ ref }}</span></div>
    <div class="swipe">Swipe for its meaning →</div>
  </div>
  <div class="bottom"><span class="handle">{{ handle }}</span><span></span></div>
</div>

{% elif card == "word-2" %}
<div class="frame">
  <div class="top"><span>In its verse</span><span class="ref">2 / 3</span></div>
  <div class="center">
    {{ ayah_lines(True) }}
    <div class="tr">{{ translation }}</div>
  </div>
  <div class="bottom"><span class="handle">{{ handle }}</span><span class="credit">{{ surah_name_en }} {{ context_ref }} · {{ translation_label }}</span></div>
</div>

{% elif card == "word-3" %}
<div class="frame">
  <div class="top"><span>Its meaning</span><span class="ref">3 / 3</span></div>
  <div class="center">
    <div class="meaning-word">{{ word }}</div>
    <div class="card">
      <h3>معنى الكلمة</h3>
      <p>{{ gloss }}</p>
      <div class="src">— {{ gloss_source }}</div>
    </div>
  </div>
  <div class="bottom"><span class="handle">{{ handle }}</span><span class="credit">{{ surah_name_en }} {{ ref }}</span></div>
</div>

{% elif card == "ayah" %}
<div class="frame">
  <div class="top"><span>Ayah of the day</span><span class="ref">{{ surah_name_en }} {{ context_ref }}</span></div>
  <div class="center">
    <div class="surah">{{ surah_name_ar }}</div>
    {{ ayah_lines(False) }}
    <div class="tr">{{ translation }}</div>
  </div>
  <div class="bottom"><span class="handle">{{ handle }}</span><span class="credit">{{ translation_label }}</span></div>
</div>
{% endif %}

<script>
  document.fonts.ready.then(() => {
    const center = document.querySelector(".center");
    const wide = () => [...document.querySelectorAll(".big-word, .meaning-word, .ayah, .tr")]
      .some(e => e.scrollWidth > center.clientWidth + 1);
    const over = () => center.scrollHeight > center.clientHeight + 1 || wide();
    let k = 1;
    for (let i = 0; center && i < 80 && over(); i++) {
      k *= 0.97;
      document.documentElement.style.setProperty("--k", k);
    }
    window.__fit = k;
  });
</script>
</body>
</html>
